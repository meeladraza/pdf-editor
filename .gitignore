# ---------------------------------------------------------
# Global ignores for pdf-editor (Vite + Express project)
# ---------------------------------------------------------

# Node dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
out/
**/dist/
**/build/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Temporary files
tmp/
temp/
.cache/
*.tmp

# Environment files
.env
.env.local
.env.*.local

# OS-specific files
.DS_Store
Thumbs.db

# IDE folders
.vscode/
.idea/
*.swp

# Puppeteer cache and Chromium binaries
**/puppeteer/.local-chromium/
**/puppeteer/.cache/

# Uploads and converted files (server outputs)
server/uploads/
server/converted/

# Vite cache
**/.vite/
vite.config.ts.timestamp-*

# Lock files (optional)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Optional: ignore test coverage
coverage/
